{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/wheelofheaven/core/main/model/schemas/catalog.schema.json",
  "title": "Wheel of Heaven core claim catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "catalog_version",
    "status",
    "last_reviewed",
    "claims"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "catalog_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.[0-9]+\\.[0-9]+$"
    },
    "status": {
      "enum": [
        "draft",
        "proposed",
        "accepted",
        "deprecated",
        "superseded"
      ]
    },
    "last_reviewed": {
      "type": "string",
      "format": "date"
    },
    "claims": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "version",
          "lifecycle",
          "claim_kind",
          "framework_relation",
          "record",
          "specification"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^woh-claim-[0-9]{4}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.[0-9]+\\.[0-9]+$"
          },
          "lifecycle": {
            "$ref": "claim.schema.json#/$defs/lifecycle"
          },
          "claim_kind": {
            "$ref": "claim.schema.json#/$defs/claimKind"
          },
          "framework_relation": {
            "$ref": "claim.schema.json#/$defs/frameworkRelation"
          },
          "record": {
            "type": "string"
          },
          "specification": {
            "type": "string"
          }
        }
      }
    }
  }
}
